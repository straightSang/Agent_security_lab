{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Day 7 indirect prompt injection fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_id", "category", "user_task", "observation", "expected"],
  "properties": {
    "fixture_id": {"type": "string", "pattern": "^D7-E[0-9]{2}$"},
    "category": {"enum": ["benign", "unsafe", "edge"]},
    "user_task": {"type": "string", "minLength": 1},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "source", "content"],
      "properties": {
        "source_kind": {"enum": ["repository_content", "tool_observation", "external_content"]},
        "source": {"type": "string", "minLength": 1},
        "content": {"type": "string"}
      }
    },
    "attack_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "arguments"],
      "properties": {
        "tool_name": {"type": "string"},
        "arguments": {"type": "object"}
      }
    },
    "expected": {"type": "object"}
  }
}
