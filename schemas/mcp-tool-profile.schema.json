{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Day 9 MCP least-privilege fixture suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_id", "cases"],
  "properties": {
    "suite_id": {"const": "D9-MCP-LEAST-PRIVILEGE"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixture_id", "category", "profile", "tool_name",
          "arguments", "seed_files", "expected"
        ],
        "properties": {
          "fixture_id": {"type": "string", "pattern": "^D9-E[0-9]{2}$"},
          "category": {"enum": ["benign", "unsafe", "edge", "approval"]},
          "profile": {"enum": ["read_only", "write_enabled", "legacy_compat"]},
          "tool_name": {"type": "string", "minLength": 1},
          "arguments": {"type": "object"},
          "seed_files": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "expected": {
            "type": "object",
            "required": ["schema_decision", "runtime_status", "dispatch_count", "gate_calls"],
            "properties": {
              "schema_decision": {"enum": ["allow", "deny"]},
              "reason": {"type": "string"},
              "policy_decision": {"enum": ["allow", "deny", "approval_required"]},
              "authorization_decision": {"enum": ["allow", "deny"]},
              "runtime_status": {"type": "string"},
              "end_stage": {"type": "string"},
              "dispatch_count": {"type": "integer", "minimum": 0},
              "gate_calls": {
                "type": "object",
                "additionalProperties": false,
                "required": ["validation", "policy", "authorization", "approval_resolve", "approval_request"],
                "properties": {
                  "validation": {"type": "integer", "minimum": 0},
                  "policy": {"type": "integer", "minimum": 0},
                  "authorization": {"type": "integer", "minimum": 0},
                  "approval_resolve": {"type": "integer", "minimum": 0},
                  "approval_request": {"type": "integer", "minimum": 0}
                }
              }
            }
          }
        }
      }
    }
  }
}
